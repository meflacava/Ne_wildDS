# Function to filter rows based on the condition
filter_rows <- function(data) {
n <- nrow(data)
i <- 2
while (i <= n) {
if (!is.na(data$position[i]) && !is.na(data$position[i - 1]) &&
data$position[i] - data$position[i - 1] <= 100000) {
data <- data[-i, ]
n <- n - 1  # Adjust the total number of rows after removal
} else {
i <- i + 1
}
}
return(data)
}
# Applying the filtering code
filtered_data <- df %>%
group_by(chr) %>%
do(filter_rows(.)) %>%
ungroup()
filtered_data <- as.data.frame(filtered_data)
